# Object Storage
object_storage.bucket_name=your-bucket-name
object_storage.endpoint=https://your-object-storage-endpoint
object_storage.public_base_url=https://your-public-base-url
object_storage.region=your-region
object_storage.prefix=rendered-html
object_storage.access_key=your-access-key
object_storage.secret_key=your-secret-key

# Preprocessor
preprocessor.base_url=https://your-preprocessor-base-url
preprocessor.path=/geo/recommend?mode=aggressive&url=

# LLM
# llm.api_url=http://your-llm-host/v1/chat/completions
# llm.model=gemma-4-fp4
llm.api_url=http://your-llm-host/v1/chat/completions
llm.model=Qwen/Qwen2.5-72B-Instruct-AWQ
llm.temperature=0
llm.max_preprocessor_chars=120000
# Semantic analysis output control (default: off)
semantic.analysis_enabled=false
llm.input_overflow_policy=error
# llm.input_overflow_policy=truncate
llm.retry_max_tokens=[1000,1500,2500]
llm.timeout_seconds=900
llm.connect_timeout_seconds=15
llm.read_timeout_seconds=900
llm.stream_enabled=false

# Prompt
prompt.file=geo_prompt_template_v4_enhanced.txt

# RAG visible passage injection
rag.injection_enabled=false
rag.injection_target=main
rag.tldr_max_chars=700

# Local output
output.save_enabled=true
output.base_dir=/absolute/path/to/geo-log
output.rendered_html_subdir=rendered_html
output.preprocessor_subdir=pre_response
output.llm_prompt_subdir=llm_prompt
output.llm_subdir=llm_response
output.llm_raw_response_subdir=llm_raw_response
output.llm_repair_subdir=llm_repair
output.injection_report_subdir=injection_report

# Debug mode
debug.enabled=true

# Playwright
playwright.goto_timeout_ms=60000
playwright.post_load_wait_ms=0
# default | android_chrome_mobile | desktop_chrome
browser.request_profile=default
browser.diagnostics_enabled=false
browser.save_render_diagnostics=false
browser.capture_shadow_dom=false
browser.capture_frames_html=false
browser.auto_scroll_enabled=false
browser.auto_scroll_step_px=800
browser.auto_scroll_wait_ms=300
browser.auto_scroll_max_steps=20
# allow | block
browser.service_workers=allow
browser.block_third_party_domains=false
# Optional. Empty means infer from target URL, e.g. www.example.com -> example.com.
browser.primary_domain_override=
# Optional comma-separated allowlist for required CDN/API domains.
browser.allowed_extra_domains=
